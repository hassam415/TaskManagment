<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        tools:context=".TaskFragment">
        <TextView
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:text="@string/PROJECT"
            android:layout_marginLeft="10dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/projectLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"

            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            android:layout_marginLeft="10dp"
           >

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/projectSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"

            android:hint="@string/Default"
            android:textSize="16sp"
            android:paddingStart="40dp"
            android:dropDownHeight="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="@string/Title">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="40dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:id="@+id/Loader"
            android:orientation="vertical"
            android:layout_width="match_parent"
           android:layout_gravity="center"
            android:visibility="gone"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </ProgressBar>
            <TextView
                android:gravity="center"
                android:text="Loading.."
                android:layout_width="match_parent"

                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/discription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"

            android:hint="@string/Discription">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="40dp"/>

        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

          >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/SELECT_TEAM"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"

                    android:layout_marginLeft="14dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:textColor="?attr/colorOnSurface"

                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="@string/SELECT_CATEGORY"
                    android:layout_gravity="end"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:paddingStart="6dp"
                android:orientation="horizontal"
                android:background="?attr/colorSurface"
                android:paddingEnd="6dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"

                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp">
                <Spinner
                    android:id="@+id/team"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/spinner_bg"
                    android:spinnerMode="dropdown"
                    android:paddingStart="8dp"
                    android:paddingEnd="24dp"/>
            </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp">

                    <Spinner
                        android:id="@+id/categoryspinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/spinner_bg"
                        android:spinnerMode="dropdown"
                        android:paddingStart="8dp"
                        android:paddingEnd="24dp"/>



                </FrameLayout>
            </LinearLayout>


              <!--  <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/spinner_bg"
                    android:spinnerMode="dropdown"
                    android:paddingStart="8dp"
                    android:paddingEnd="24dp"/>
-->





            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">
                <TextView
                    android:layout_width="0dp"
                    android:text="@string/SELECT_PRIORITY"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"

                    android:layout_marginTop="6dp"
                    android:layout_marginLeft="13dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/DESIGINATED_REVIEWERS"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"

                    android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="?attr/colorSurface"
                android:weightSum="2">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp">

                    <Spinner
                        android:id="@+id/periorityspinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/spinner_bg"
                        android:spinnerMode="dropdown"
                        android:paddingStart="8dp"
                        android:paddingEnd="24dp"/>



                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp">

                    <Spinner
                        android:id="@+id/revierSpiner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/spinner_bg"
                        android:spinnerMode="dropdown"
                        android:paddingStart="8dp"
                        android:paddingEnd="24dp"/>



                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
     <!--   <com.example.taskmanagement.CustomImagView
            android:id="@+id/customImageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

       </com.example.taskmanagement.CustomImagView>
  -->
        <com.example.taskmanagement.CustomUserView
           android:id="@+id/customUser"
           android:layout_width="match_parent"
           android:layout_height="wrap_content">

       </com.example.taskmanagement.CustomUserView>
        <TextView
            android:text="@string/ESTIMATE_HOURS"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"

            android:layout_marginLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:id="@+id/hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="e.g.16.0">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:paddingStart="40dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:text="@string/START_DATE"
            android:textColor="?attr/colorOnSurface"

            android:textStyle="bold"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ddmmyyyy"
            android:layout_margin="10dp"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/startDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="40dp"
                android:drawableTint="?attr/colorOnSurface"

                android:drawableEnd="@drawable/outline_calendar_month_24" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textStyle="bold"
            android:text="@string/DUE_DATE"
            android:textColor="?attr/colorOnSurface"


            android:layout_marginLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"

            android:hint="@string/ddmmyyyy">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dueDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="40dp"
                android:drawableTint="?attr/colorOnSurface"

                android:drawableEnd="@drawable/outline_calendar_month_24"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/savebtn"
            android:textColor="@color/white"
            android:text="@string/Create"
            android:layout_gravity="center"
            android:backgroundTint="@color/darknavey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>

</layout>