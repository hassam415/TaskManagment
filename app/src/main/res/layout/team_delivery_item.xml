<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        >
        <TextView
            android:id="@+id/teamName"
            android:text="CREATED"
            android:textStyle="bold"

            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:textSize="12dp"
            android:layout_marginLeft="5dp"
            android:layout_height="wrap_content"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="2dp"
            android:weightSum="6">



            <TextView
                android:id="@+id/createdTask"
                android:text="CREATED"
android:gravity="center"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:textSize="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/completedTask"
                android:textColor="@color/lightGreen"
                android:text="COMPLETED"
                android:textStyle="bold"
                android:gravity="center"
                android:textSize="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/activeTask"
                android:textStyle="bold"
                android:textSize="10dp"
                android:gravity="center"

                android:text="ACTIVE"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/dueTask"
                android:textStyle="bold"
                android:textSize="10dp"
                android:text="OVERDUE"

android:gravity="center"
                android:textColor="@color/brightRed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/slaTime"
                android:textStyle="bold"
                android:textSize="10dp"
                android:text="ON_TIME SLA"
                android:textColor="@color/duk_blue"
                android:layout_width="0dp"
android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/hours"
                android:textStyle="bold"
                android:textSize="10dp"
                android:text="HOURS LOGGED"
                android:layout_width="0dp"
android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <View
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />
    </LinearLayout>
</layout>